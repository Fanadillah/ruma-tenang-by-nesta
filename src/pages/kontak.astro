---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---
<Base title="Kontak RUMA TENANG by NESTA — WA, Alamat, Jam & Peta" description="Hubungi RUMA TENANG: WA 0812-XXXX balas <1 jam, alamat Jakarta Selatan, jam 08-17 WIB, email halo@rumatenang.id">
  <Navbar />
  <div class="pt-28">
    <div class="max-w-[1120px] mx-auto px-4">
      <Breadcrumb items={[{label:'Beranda', href:'/'}, {label:'Kontak'}]} />
      <div class="mt-4 reveal">
        <span class="inline-flex items-center gap-2 bg-terracotta/10 border border-terracotta/20 text-terracotta px-3 py-1 rounded-full text-xs font-bold">Balas &lt;1 jam • Garansi • Jabodetabek</span>
        <h1 class="font-display font-extrabold text-[clamp(2rem,5vw,3rem)] leading-none mt-3">Ngobrol dulu, <em class="text-terracotta">gratis.</em></h1>
        <p class="text-ink/60 mt-2 max-w-[640px]">Kirim alamat + foto ruangan, kami balas estimasi jujur. Tidak ada biaya survei untuk area &gt;80m².</p>
      </div>

      <!-- 4 cards -->
      <div class="grid md:grid-cols-4 gap-4 mt-8">
        <div class="reveal bg-white border border-sand rounded-bento p-5">
          <div class="w-10 h-10 rounded-xl bg-[#25D366] text-white grid place-items-center"><i class="fa-brands fa-whatsapp"></i></div>
          <div class="font-bold mt-3">WhatsApp</div><div class="text-sm text-ink/60">0812-XXXX-XXXX</div><div class="text-xs text-sage mt-1">Balas &lt;1 jam (08-17 WIB)</div>
          <a data-wa="Halo RUMA TENANG, saya mau konsultasi." class="inline-block mt-3 bg-[#25D366] text-white px-4 py-2 rounded-full text-sm font-bold">Chat Sekarang</a>
        </div>
        <div class="reveal bg-white border border-sand rounded-bento p-5">
          <div class="w-10 h-10 rounded-xl bg-terracotta text-white grid place-items-center"><i class="fa-solid fa-location-dot"></i></div>
          <div class="font-bold mt-3">Alamat</div><div class="text-sm text-ink/60">Jl. Contoh Raya No.123<br/>Jakarta Selatan [GANTI]</div>
          <a href="#peta" class="text-xs text-terracotta font-bold mt-2 inline-block">Lihat Peta ↓</a>
        </div>
        <div class="reveal bg-white border border-sand rounded-bento p-5">
          <div class="w-10 h-10 rounded-xl bg-charcoal text-white grid place-items-center"><i class="fa-solid fa-clock"></i></div>
          <div class="font-bold mt-3">Jam</div><div class="text-sm text-ink/60">Senin–Sabtu<br/>08.00–17.00 WIB</div><div class="text-xs text-ink/50">Minggu tutup</div>
        </div>
        <div class="reveal bg-white border border-sand rounded-bento p-5">
          <div class="w-10 h-10 rounded-xl bg-sage text-white grid place-items-center"><i class="fa-solid fa-envelope"></i></div>
          <div class="font-bold mt-3">Email</div><div class="text-sm text-ink/60">halo@rumatenang.id</div><div class="text-xs text-ink/50">Untuk invoice</div>
        </div>
      </div>

      <!-- Map + Form -->
      <div class="grid lg:grid-cols-2 gap-6 mt-8">
        <div id="peta" class="reveal rounded-bento overflow-hidden border border-sand h-[420px]">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.466474515!2d106.810611!3d-6.261493!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNsKwMTUnNDEuNCJTIDEwNsKwNDgnMzguMiJF!5e0!3m2!1sen!2sid!4v1700000000000" width="100%" height="100%" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Peta RUMA TENANG"></iframe>
        </div>
        <div class="reveal bg-white border border-sand rounded-bento p-6">
          <h2 class="font-display font-bold text-xl">Kirim Alamat — Langsung WA</h2>
          <p class="text-sm text-ink/60">Data tidak disimpan, hanya untuk estimasi.</p>
          <form class="mt-4 space-y-3" onsubmit="event.preventDefault(); const f=new FormData(this); const n=f.get('nama'); const a=f.get('alamat'); const l=f.get('layanan'); window.open('https://wa.me/6281234567890?text='+encodeURIComponent(`Halo RUMA TENANG, saya ${n}, alamat di ${a}, mau ${l}. Boleh estimasi?`),'_blank')">
            <input name="nama" placeholder="Nama kamu" class="w-full rounded-full border border-sand px-4 py-3" required />
            <input name="alamat" placeholder="Alamat lengkap + patokan" class="w-full rounded-full border border-sand px-4 py-3" required />
            <select name="layanan" class="w-full rounded-full border border-sand px-4 py-3 bg-white"><option>Deep Tenang</option><option>Rapi Cepat</option><option>Tenang Rutin</option><option>Cuci Sofa</option></select>
            <button class="w-full bg-terracotta hover:bg-terracotta-dark text-white rounded-full py-3 font-bold flex justify-center gap-2"><i class="fa-brands fa-whatsapp"></i> Kirim via WhatsApp</button>
          </form>
          <div class="flex gap-2 mt-4 text-xs"><span class="bg-warm border border-sand px-3 py-1 rounded-full">Gratis survei &gt;80m²</span><span class="bg-warm border border-sand px-3 py-1 rounded-full">Garansi 24 jam</span></div>
        </div>
      </div>

      <!-- FAQ mini -->
      <div class="max-w-[760px] mx-auto mt-12">
        <h2 class="font-display font-bold text-2xl text-center reveal">Tanya sebelum WA?</h2>
        <div class="mt-4 space-y-2">
          <details class="reveal bg-warm border border-sand rounded-bento p-4"><summary class="font-semibold cursor-pointer">Apakah bisa H-1?</summary><p class="text-sm text-ink/60 mt-2">Bisa, minimal H-1 jam 15.00. H+0 tergantung slot.</p></details>
          <details class="reveal bg-warm border border-sand rounded-bento p-4"><summary class="font-semibold cursor-pointer">Apakah ada biaya transport?</summary><p class="text-sm text-ink/60 mt-2">Gratis Jabodetabek, luar area WA dulu.</p></details>
        </div>
      </div>
    </div>
  </div>
  <footer class="bg-charcoal text-white/60 text-center text-xs py-6 mt-12">© 2026 RUMA TENANG by NESTA</footer>
</Base>
