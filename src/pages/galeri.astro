---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---
<Base title="Galeri Before-After — Museum Bukti RUMA TENANG by NESTA" description="Galeri hasil nyata: dapur, kamar mandi, sofa. Geser slider, klik lightbox, filter kategori.">
  <Navbar />
  <div class="pt-24 md:pt-28">
    <div class="max-w-[1120px] mx-auto px-4">
      <Breadcrumb items={[{label:'Beranda', href:'/'}, {label:'Galeri'}]} />
      <div class="text-center reveal mt-4 max-w-[720px] mx-auto">
        <span class="inline-flex bg-sage/15 border border-sage/20 text-sage px-3 py-1 rounded-full text-xs font-bold tracking-wide">Galeri • 100% Foto Asli</span>
        <h1 class="font-display font-extrabold text-3xl md:text-4xl leading-none mt-3">Hasil Nyata — <em class="text-terracotta font-semibold">Sebelum & Sesudah</em></h1>
        <p class="text-ink/60 mt-3 text-sm md:text-base">Bukan editan/filter. Geser slider untuk bandingkan, klik foto untuk perbesar. Setiap foto ada lokasi, luas & paket.</p>
        <div class="mt-6">
          <div class="text-xs font-bold tracking-[0.15em] uppercase text-ink/50 mb-2">Saring Kategori</div>
          <div class="flex justify-center gap-2 flex-wrap" id="galeri-filter">
            <button data-filter="all" class="filter-btn bg-charcoal text-white px-5 py-2 rounded-full text-sm font-bold min-h-[36px]">Semua</button>
            <button data-filter="dapur" class="filter-btn bg-white border border-sand px-5 py-2 rounded-full text-sm min-h-[36px]">Dapur</button>
            <button data-filter="kamar" class="filter-btn bg-white border border-sand px-5 py-2 rounded-full text-sm min-h-[36px]">Kamar Mandi</button>
            <button data-filter="sofa" class="filter-btn bg-white border border-sand px-5 py-2 rounded-full text-sm min-h-[36px]">Sofa & Karpet</button>
          </div>
        </div>
      </div>

      <!-- Slider masonry -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 mt-6 md:mt-8" id="galeri-grid">
        <div data-cat="dapur" class="reveal galeri-item">
          <div data-ba class="relative rounded-bento overflow-hidden border border-sand h-56 cursor-ew-resize select-none touch-none">
            <img src="/images-v2/ba-dapur-before.jpg" class="absolute inset-0 w-full h-full object-cover" alt="before dapur" />
            <img data-ba-after src="/images-v2/ba-dapur-after.jpg" class="absolute inset-0 w-full h-full object-cover" style="clip-path: inset(0 50% 0 0)" alt="after dapur" />
            <span data-ba-handle class="absolute top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-terracotta text-white grid place-items-center border-2 border-white" style="left:50%"><i class="fa-solid fa-arrows-left-right text-xs"></i></span>
          </div>
          <div class="text-sm font-semibold mt-2">Dapur Berminyak → Kinclong</div><div class="text-xs text-ink/50">Bekasi • 85m² • Deep Tenang • 5 jam</div>
        </div>
        <div data-cat="kamar" class="reveal galeri-item">
          <div data-ba class="relative rounded-bento overflow-hidden border border-sand h-56 cursor-ew-resize select-none touch-none">
            <img src="/images-v2/ba-kamar-before.jpg" class="absolute inset-0 w-full h-full object-cover" alt="before kamar" />
            <img data-ba-after src="/images-v2/ba-kamar-after.jpg" class="absolute inset-0 w-full h-full object-cover" style="clip-path: inset(0 50% 0 0)" alt="after kamar" />
            <span data-ba-handle class="absolute top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-terracotta text-white grid place-items-center border-2 border-white" style="left:50%"><i class="fa-solid fa-arrows-left-right text-xs"></i></span>
          </div>
          <div class="text-sm font-semibold mt-2">Kamar Mandi Berkerak → Kesat</div><div class="text-xs text-ink/50">Jakarta Selatan • 60m² • Deep • 5 jam</div>
        </div>
        <div data-cat="sofa" class="reveal galeri-item">
          <div data-ba class="relative rounded-bento overflow-hidden border border-sand h-56 cursor-ew-resize select-none touch-none">
            <img src="/images-v2/ba-sofa-before.jpg" class="absolute inset-0 w-full h-full object-cover" alt="before sofa" />
            <img data-ba-after src="/images-v2/ba-sofa-after.jpg" class="absolute inset-0 w-full h-full object-cover" style="clip-path: inset(0 50% 0 0)" alt="after sofa" />
            <span data-ba-handle class="absolute top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-terracotta text-white grid place-items-center border-2 border-white" style="left:50%"><i class="fa-solid fa-arrows-left-right text-xs"></i></span>
          </div>
          <div class="text-sm font-semibold mt-2">Sofa Kusam → Segar</div><div class="text-xs text-ink/50">Depok • Sofa 3-seater • Carpet & Sofa</div>
        </div>
        <div data-cat="dapur" class="reveal galeri-item"><img src="/images-v2/bento-debu.jpg" class="rounded-bento w-full h-56 object-cover border border-sand cursor-pointer lightbox-img" alt="hasil" /><div class="text-sm font-semibold mt-2">Sudut Plafon Bersih</div><div class="text-xs text-ink/50">Tangerang • Home Cleaning</div></div>
        <div data-cat="sofa" class="reveal galeri-item"><img src="/images-v2/bento-sofa.jpg" class="rounded-bento w-full h-56 object-cover border border-sand cursor-pointer lightbox-img" alt="hasil" /><div class="text-sm font-semibold mt-2">Karpet Wangi</div><div class="text-xs text-ink/50">Bogor • Carpet</div></div>
        <div data-cat="kamar" class="reveal galeri-item"><img src="/images-v2/paket-deep.jpg" class="rounded-bento w-full h-56 object-cover border border-sand cursor-pointer lightbox-img" alt="hasil" /><div class="text-sm font-semibold mt-2">Lantai Kinclong</div><div class="text-xs text-ink/50">Jakarta • Deep Tenang</div></div>
      </div>

      <div class="text-center mt-10"><a data-wa="Halo RUMA TENANG, saya mau rumah saya jadi next before-after." class="bg-terracotta text-white px-8 py-3 rounded-full font-bold">Mau Rumahmu Next? WA</a></div>
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 bg-black/80 hidden place-items-center z-[60] p-4"><img id="lightbox-img" src="" class="max-w-[90vw] max-h-[85vh] rounded-bento" alt="" /><button id="lightbox-close" class="absolute top-4 right-4 text-white text-2xl">×</button></div>

  <footer class="bg-charcoal text-white/60 text-center text-xs py-6 mt-12">© 2026 RUMA TENANG by NESTA</footer>
  <script>
    // filter
    const btns = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.galeri-item');
    btns.forEach(b=> b.addEventListener('click', ()=>{
      const f=b.getAttribute('data-filter');
      btns.forEach(x=> x.className='filter-btn bg-white border border-sand px-5 py-2 rounded-full text-sm min-h-[36px]');
      b.className='filter-btn bg-charcoal text-white px-5 py-2 rounded-full text-sm font-bold min-h-[36px]';
      items.forEach(it=>{
        const c=it.getAttribute('data-cat');
        it.style.display = (f==='all'||c===f)?'':'none';
      });
    }));
    // lightbox
    const lb=document.getElementById('lightbox');
    const lbi=document.getElementById('lightbox-img');
    const lbc=document.getElementById('lightbox-close');
    document.querySelectorAll('.lightbox-img').forEach(img=>{
      img.addEventListener('click', ()=>{ lbi.src=img.src; lb.classList.remove('hidden'); lb.classList.add('grid'); });
    });
    lbc&&lbc.addEventListener('click', ()=>{ lb.classList.add('hidden'); lb.classList.remove('grid'); });
    lb&&lb.addEventListener('click', (e)=>{ if(e.target===lb){ lb.classList.add('hidden'); lb.classList.remove('grid'); }});
  </script>
</Base>
